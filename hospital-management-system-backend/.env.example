# Hospital & Doctor Management System — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=5000
API_BASE_PATH=/api/v1
# Comma-separated list of allowed origins, or * to allow all (development only)
CORS_ORIGIN=http://localhost:3000
# Public URL of the web frontend. Payment callbacks redirect the browser here.
FRONTEND_URL=http://localhost:3000
# Public URL of this API (used to build SSLCommerz callback URLs)
API_PUBLIC_URL=http://localhost:5000
# Hospital timezone offset from UTC in minutes (Asia/Dhaka = 360). Used to decide
# whether an appointment slot is already in the past.
HOSPITAL_UTC_OFFSET_MINUTES=360

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# --- JWT (use long random strings, e.g. `openssl rand -hex 48`) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- SSLCommerz (sandbox credentials from https://developer.sslcommerz.com) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# --- Cloudinary (optional, file uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (optional, email notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
